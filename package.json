{
  "name": "jev-does-not-play-dice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recorded Jev probability experiments, offline analysis, and API examples.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "preview": "node src/run.mjs",
